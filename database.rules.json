{
  "rules": {
    "availability": {
      "$providerId": {
        "$slotDate": {
          "$slotTime": {
            ".read": "auth != null",
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['status']) && ( (newData.child('status').val() == 'open' && (!data.exists() || data.child('status').val() == 'open' || data.child('status').val() == 'pending_lock')) || (newData.child('status').val() == 'pending_lock' && newData.child('lockOwner').isString() && newData.child('lockedAt').isNumber() && (!data.exists() || data.child('status').val() == 'open' || data.child('status').val() == 'pending_lock')) || (newData.child('status').val() == 'booked' && data.child('status').val() == 'pending_lock' && data.child('lockOwner').exists() && newData.child('lockOwner').val() == data.child('lockOwner').val() && (!newData.child('priceCents').exists() || newData.child('priceCents').isNumber())) )",
            "status": {
              ".validate": "newData.isString() && newData.val().matches(/^(open|pending_lock|booked)$/)"
            },
            "lockOwner": {
              ".validate": "!newData.exists() || newData.isString()"
            },
            "lockedAt": {
              ".validate": "!newData.exists() || newData.isNumber()"
            },
            "providerId": {
              ".validate": "!newData.exists() || newData.val() == $providerId"
            },
            "seekerId": {
              ".validate": "!newData.exists() || newData.isString()"
            },
            "bookedAt": {
              ".validate": "!newData.exists() || newData.isString()"
            },
            "priceCents": {
              ".validate": "!newData.exists() || newData.isNumber()"
            }
          }
        }
      }
    },
    "bookings": {
      "$bookingId": {
        ".read": "auth != null && (data.child('seekerId').val() == auth.uid || data.child('providerId').val() == auth.uid)",
        ".write": "auth != null && (( !data.exists() && newData.child('seekerId').val() == auth.uid) || (data.exists() && data.child('providerId').val() == auth.uid))",
        "providerId": {
          ".validate": "newData.isString()"
        },
        "seekerId": {
          ".validate": "newData.isString()"
        },
        "slotDate": {
          ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)"
        },
        "slotTime": {
          ".validate": "newData.isString() && newData.val().matches(/^\\d{2}-\\d{2}$/)"
        },
        "slotUtc": {
          ".validate": "newData.isString()"
        },
        "priceCents": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(Pending|booked|rescheduled|Cancelled|In Progress|Completed|Requested|Accepted|Confirmed)$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "address": {
          ".validate": "newData.isString()"
        },
        "problemDescription": {
          ".validate": "newData.isString()"
        }
      }
    },
    "providerPublic": {
      "$providerId": {
        ".read": true,
        ".write": "auth != null && auth.uid == $providerId",
        "name": {
          ".validate": "newData.isString()"
        },
        "photoUrl": {
          ".validate": "newData.isString() && newData.val().matches(/^(https?:\\/\\/[^\\s]+)$/)"
        },
        "priceCents": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "users": {
      ".read": "auth != null",
      ".indexOn": [
        "category",
        "userType"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}