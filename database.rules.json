{
  "rules": {
    "availability": {
      "$providerId": {
        "$slotDate": {
          "$slotTime": {
            ".read": "auth != null && (auth.uid == $providerId || root.child('users').child(auth.uid).child('userType').val() == 'seeker')",
            ".write": "auth != null && (auth.uid == $providerId || root.child('users').child(auth.uid).child('userType').val() == 'seeker')",
            ".validate": "newData.hasChildren(['status']) && ((newData.child('status').val() == 'open' && (!data.exists() || data.child('status').val() == 'open' || data.child('status').val() == 'pending_lock')) || (newData.child('status').val() == 'pending_lock' && newData.child('lockOwner').isString() && newData.child('lockedAt').isNumber() && newData.child('ownerId').isString() && (!data.exists() || data.child('status').val() == 'open' || data.child('status').val() == 'pending_lock')) || (newData.child('status').val() == 'booked' && data.child('status').val() == 'pending_lock' && data.child('lockOwner').exists() && newData.child('lockOwner').val() == data.child('lockOwner').val() && newData.child('providerId').isString() && (!newData.child('priceCents').exists() || newData.child('priceCents').isNumber()) && (!newData.child('seekerId').exists() || newData.child('seekerId').isString()) && (!newData.child('bookedAt').exists() || newData.child('bookedAt').isString())))",
            "status": {
              ".validate": "newData.isString() && newData.val().matches(/^(open|pending_lock|booked)$/)"
            },
            "lockOwner": {
              ".validate": "newData.isString()"
            },
            "lockedAt": {
              ".validate": "newData.isNumber()"
            },
            "ownerId": {
              ".validate": "newData.isString()"
            },
            "providerId": {
              ".validate": "newData.isString() && newData.val() == $providerId"
            },
            "seekerId": {
              ".validate": "newData.isString()"
            },
            "bookedAt": {
              ".validate": "newData.isString()"
            },
            "priceCents": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "bookings": {
      ".read": "auth != null",
      ".indexOn": ["providerId", "seekerId", "status"],
      "$bookingId": {
        ".write": "auth != null && ((!data.exists() && newData.child('seekerId').val() == auth.uid) || (data.exists() && (data.child('providerId').val() == auth.uid || data.child('seekerId').val() == auth.uid)))",
        ".validate": "newData.hasChildren(['providerId', 'seekerId', 'slotDate', 'slotTime', 'slotUtc', 'status', 'address', 'problemDescription'])",
        "providerId": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() == data.val())"
        },
        "seekerId": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() == data.val())"
        },
        "slotDate": {
          ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)"
        },
        "slotTime": {
          ".validate": "newData.isString() && newData.val().matches(/^\\d{2}-\\d{2}$/)"
        },
        "slotUtc": {
          ".validate": "newData.isString()"
        },
        "priceCents": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(pending|booked|rescheduled|cancelled|declined|in progress|completed|requested|accepted|confirmed)$/i) && ((!data.exists()) || (auth.uid == root.child('bookings').child($bookingId).child('providerId').val() && newData.val().matches(/^(accepted|confirmed|declined|in progress|completed)$/i)) || (auth.uid == root.child('bookings').child($bookingId).child('seekerId').val() && newData.val().matches(/^(pending|cancelled|rescheduled)$/i)))"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())"
        },
        "address": {
          ".validate": "newData.isString()"
        },
        "problemDescription": {
          ".validate": "newData.isString()"
        },
        "bookingId": {
          ".validate": "newData.isString()"
        },
        "seekerName": {
          ".validate": "newData.isString()"
        },
        "providerName": {
          ".validate": "newData.isString()"
        },
        "serviceId": {
          ".validate": "newData.isString()"
        },
        "serviceName": {
          ".validate": "newData.isString()"
        },
        "serviceCategory": {
          ".validate": "newData.isString()"
        },
        "scheduleDate": {
          ".validate": "newData.isString()"
        },
        "scheduleTime": {
          ".validate": "newData.isString()"
        },
        "notes": {
          ".validate": "newData.isString()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "providerPublic": {
      "$providerId": {
        ".read": true,
        ".write": "auth != null && auth.uid == $providerId",
        "name": {
          ".validate": "newData.isString()"
        },
        "photoUrl": {
          ".validate": "newData.isString() && newData.val().matches(/^(https?:\\/\\/[^\\s]+)$/)"
        },
        "priceCents": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "users": {
      ".read": "auth != null",
      ".indexOn": ["category", "userType"],
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && (data.child('participant1Id').val() == auth.uid || data.child('participant2Id').val() == auth.uid)",
        ".write": "auth != null && ((!data.exists() && (newData.child('participant1Id').val() == auth.uid || newData.child('participant2Id').val() == auth.uid)) || (data.exists() && (data.child('participant1Id').val() == auth.uid || data.child('participant2Id').val() == auth.uid)))"
      }
    },
    "messages": {
      "$messageId": {
        ".read": "auth != null",
        ".write": "auth != null && newData.child('senderId').val() == auth.uid"
      }
    }
  }
}