{
  "rules": {
    "availability": {
      "$providerId": {
        "$slotDate": {
          "$slotTime": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        }
      }
    },
    "bookings": {
      ".read": "auth != null",
      ".indexOn": ["providerId", "seekerId", "status"],
      "$bookingId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "providerPublic": {
      "$providerId": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "users": {
      ".read": "auth != null",
      ".indexOn": ["category", "userType"],
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "messages": {
      "$messageId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}